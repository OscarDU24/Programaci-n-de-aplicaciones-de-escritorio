<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.tarea1.VerRegistrosController"
      alignment="CENTER"
      spacing="15">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="Clases Registradas"/>
    <TableView fx:id="tablaClases"
               prefWidth="600"
               prefHeight="300">
        <columns>
            <TableColumn fx:id="colNombre"
                         text="Nombre"
                         prefWidth="150"/>
            <TableColumn fx:id="colProfesor"
                         text="Profesor"
                         prefWidth="150"/>
            <TableColumn fx:id="colFecha"
                         text="Fecha"
                         prefWidth="120"/>
            <TableColumn fx:id="colAula"
                         text="Aula"
                         prefWidth="100"/>
        </columns>
    </TableView>
    <Button text="Volver"
            onAction="#volverMenu"/>

</VBox>